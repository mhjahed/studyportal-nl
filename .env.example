# ═══════════════════════════════════════════════════════════
# EmailJS Configuration
# See EMAILJS_SETUP.md for detailed setup instructions.
# ═══════════════════════════════════════════════════════════
#
# The application works WITHOUT these values — requests will
# be saved locally and queued for later delivery.

# Your EmailJS Service ID (from Email Services page)
VITE_EMAILJS_SERVICE_ID=service_m9mkkl8

# Your EmailJS Public Key (from Account → General)
VITE_EMAILJS_PUBLIC_KEY=N6IuQC3uhfQNJCXRG

# Template IDs (only TWO templates needed — fits the free tier)
VITE_EMAILJS_REGISTRATION_TEMPLATE=template_73z26bj
VITE_EMAILJS_INTERVIEW_TEMPLATE=template_pm32qp6

# ═══════════════════════════════════════════════════════════
# Developer Tools Access
# ═══════════════════════════════════════════════════════════

VITE_DEV_TOOLS_PASSPHRASE=change_me

# ═══════════════════════════════════════════════════════════
# Remote data source
# ═══════════════════════════════════════════════════════════
# By default, the app reads JSON from /data/ (i.e. public/data/ folder).
# To use a GitHub repo or external CDN instead, set this to that URL:
#
# VITE_REMOTE_DATA_URL=https://raw.githubusercontent.com/username/repo/main/data
#
# Leave blank to use the deployed /data/ folder (recommended).

VITE_REMOTE_DATA_URL=